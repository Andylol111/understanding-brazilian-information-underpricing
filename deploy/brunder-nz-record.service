# Records the Electoral Commission's official XML media feed (media.election.net.nz/xml, linked from its
# 2026 media kit) for the New Zealand general election, 2026-11-07; only changed files are stored.
# Started by brunder-nz-record.timer. See docs/newzealand.md.
[Unit]
Description=brunder recorder: New Zealand general election 2026-11-07 (official XML media feed)
Wants=network-online.target
After=network-online.target

[Service]
User=brunder
WorkingDirectory=/srv/brunder/repo
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/brunder/.local/bin/uv run --frozen brunder nz record configs/nz2026_v2.toml --interval 120 --until 2026-11-28T12:00Z
Restart=on-failure
RestartSec=30
Nice=10
CPUQuota=15%
MemoryMax=512M

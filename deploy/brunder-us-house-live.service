# Live US House district models (2026-11-03; brunder.us_house_night, docs/us_midterms.md#house): its own process,
# isolated from brunder-us-live (the registered Senate/governor forward test). Re-reads the recorder's archive
# (brunder-snap-us) every 60 s and writes only site/data/us2026/house_live/, which brunder-site serves. Never polls
# the official feeds. Every configured district with a recorded feed, most competitive market first
# (analysis/us_house_night.py by_competitiveness): the 59 registered TX/FL/NC/OH/GA/AZ districts (SC's 4 are
# excluded: its feed is not recorded, prereg/NOTES.md) and the 12 PA/MN/NE/NM districts added 2026-10-30 (configs
# us2026_house_{pa,mn,ne,nm}-*; drop their lines if they are not registered). Cost, Mac replay of the rehearsal
# archive (240 simulated minutes, every feed changing every minute; analysis/us_house_night.py bench): 59 districts
# 0.42 s CPU per cycle median, 0.71 s p95 (63 districts 0.42 / 0.78 s; before the numpy projection and per-district
# memo 3.76 / 5.83 s, identical output), peak RSS 0.3 GB. Started by brunder-election-night.target.
[Unit]
Description=brunder live House district models: US midterms 2026-11-03
After=brunder-snap-us.service

[Service]
User=brunder
WorkingDirectory=/srv/brunder/repo
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/brunder/.local/bin/uv run --frozen python -m brunder.us_house_night live \
  configs/us2026_house/pa-01_v1.toml configs/us2026_house/tx-23_v1.toml configs/us2026_house/nc-03_v1.toml \
  configs/us2026_house/nc-13_v1.toml configs/us2026_house/mn-01_v1.toml configs/us2026_house/oh-15_v1.toml \
  configs/us2026_house/fl-27_v1.toml configs/us2026_house/fl-09_v1.toml configs/us2026_house/az-02_v1.toml \
  configs/us2026_house/nc-09_v1.toml configs/us2026_house/fl-22_v1.toml configs/us2026_house/tx-35_v1.toml \
  configs/us2026_house/fl-14_v1.toml configs/us2026_house/oh-10_v1.toml configs/us2026_house/fl-13_v1.toml \
  configs/us2026_house/fl-07_v1.toml configs/us2026_house/nc-14_v1.toml configs/us2026_house/nc-07_v1.toml \
  configs/us2026_house/ne-01_v1.toml configs/us2026_house/fl-16_v1.toml configs/us2026_house/oh-09_v1.toml \
  configs/us2026_house/tx-09_v1.toml configs/us2026_house/fl-25_v1.toml configs/us2026_house/az-01_v1.toml \
  configs/us2026_house/fl-04_v1.toml configs/us2026_house/pa-10_v1.toml configs/us2026_house/fl-12_v1.toml \
  configs/us2026_house/nc-01_v1.toml configs/us2026_house/mn-08_v1.toml configs/us2026_house/ga-12_v1.toml \
  configs/us2026_house/fl-26_v1.toml configs/us2026_house/nc-05_v1.toml configs/us2026_house/pa-07_v1.toml \
  configs/us2026_house/oh-07_v1.toml configs/us2026_house/az-05_v1.toml configs/us2026_house/pa-08_v1.toml \
  configs/us2026_house/tx-32_v1.toml configs/us2026_house/tx-15_v1.toml configs/us2026_house/az-08_v1.toml \
  configs/us2026_house/fl-11_v1.toml configs/us2026_house/nc-11_v1.toml configs/us2026_house/fl-21_v1.toml \

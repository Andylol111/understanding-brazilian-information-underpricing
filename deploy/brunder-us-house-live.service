  configs/us2026_house/oh-01_v1.toml configs/us2026_house/mn-06_v1.toml \
  --out /srv/brunder/repo/site/data --interval 60 --until 2026-11-20T00:00Z
Restart=on-failure
RestartSec=30
Nice=15
CPUQuota=25%
MemoryMax=1G
IOSchedulingClass=idle

[Install]
WantedBy=brunder-election-night.target
